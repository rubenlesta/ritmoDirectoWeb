# Replace with a unique, random secret before deploying.
SECRET_KEY=replace_with_a_random_secret

# Leave empty to use SQLite at instance/ritmo_directo.db.
# For MySQL/MariaDB, use a SQLAlchemy URL, e.g.
# mysql+pymysql://user:password@localhost/musica
DATABASE_URL=

# Empty values use paths under the project directory.
MP3_FOLDER=
COOKIES_PATH=

# HTTP ports. In production, bind services to localhost behind HTTPS proxy.
PORT=5000
STATS_PORT=5001

# Keep disabled in production.
DEBUG=False

# yt-dlp network socket timeout, in seconds.
DOWNLOAD_SOCKET_TIMEOUT=30
